{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": [
    "src/**/__tests__/*",
    "src/components/dialogs/UserPermissionsDialog.vue",
    "src/components/forms/IncomeForm.vue",
    "src/components/forms/RoleForm.vue",
    "src/components/forms/UserRoleAssignForm.vue",
    "src/views/permissions/RoleList.vue",
    "src/views/permissions/UserRoleList.vue"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
